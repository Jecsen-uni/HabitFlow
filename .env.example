# HabitFlow environment template.
# Copy this file to .env for local development:
#   Copy-Item .env.example .env

# Express HTTP port.
PORT=3000

# Runtime mode: development, test, or production.
NODE_ENV=development

# Use "memory" for a fast demo without PostgreSQL.
# Use PostgreSQL for the main architecture/runtime:
#   postgres://postgres:postgres@localhost:5432/habit_tracker
DATABASE_URL=postgres://postgres:postgres@localhost:5432/habit_tracker

# Allowed browser origins.
# "*" is convenient for development; use explicit domains in production.
CORS_ORIGIN=*
